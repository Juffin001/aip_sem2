<?xml version="1.0" encoding="UTF-8"?><coreProperties xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.openxmlformats.org/package/2006/metadata/core-properties"><dc:creator>Mike Kestner</dc:creator><dc:description>This package contains native win32 GTK3 libraries to be used by Gtk# on Windows. Gtk# is a .NET language binding for the GTK+ toolkit and assorted GNOME libraries.</dc:description><dc:identifier>GtkSharp.Win32</dc:identifier><keywords>GTK3 GTK# gtk3-sharp</keywords><lastModifiedBy>NuGet.Core, Version=2.8.1.0, Culture=neutral, PublicKeyToken=null;Unix 3.18.7.200;</lastModifiedBy><version>3.1.2</version></coreProperties>